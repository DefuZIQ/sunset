DOMAIN=t3ch.pro
POSTGRES_DB=sunset
POSTGRES_USER=sunset
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
MFA_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes-and-back-up-securely
# Keep local until the internal IAM HTTP journey and staff database cutover pass.
IAM_MODE=local
INTERNAL_IAM_SECRET=replace-with-a-separate-random-secret-at-least-32-chars
PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=replace-with-a-long-random-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
TRACING_ENABLED=false
TRACING_SAMPLING_PROBABILITY=0.1
OTLP_TRACING_ENDPOINT=http://tempo:4318/v1/traces
# Optional. Configure privately on the server to enable DaData address lookup.
DADATA_API_KEY=
