{
  "openapi": "3.0.3",
  "info": {
    "title": "SUNSET Store API — core client operations",
    "version": "1.0.0",
    "description": "Подтверждённое по контроллерам ядро клиентского API. Это не полный перечень административных и вспомогательных маршрутов. Старые пути без /api/v1 пока сохранены."
  },
  "servers": [{ "url": "/api/v1", "description": "Версионированный путь через Caddy и Gateway" }],
  "tags": [
    { "name": "Auth" }, { "name": "Products" }, { "name": "Orders" }, { "name": "Promotions" },
    { "name": "Reviews" }, { "name": "Notifications" }, { "name": "Subscriptions" }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"], "operationId": "registerCustomer", "summary": "Регистрация клиента",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } } },
        "responses": { "200": { "description": "Создан аккаунт; JWT выдаётся при последующем входе", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } }, "400": { "$ref": "#/components/responses/BadRequest" } }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"], "operationId": "loginCustomer", "summary": "Вход",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": { "200": { "description": "Выдан JWT", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/auth/profile": {
      "get": {
        "tags": ["Auth"], "operationId": "getProfile", "summary": "Профиль текущего клиента", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Профиль", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "put": {
        "tags": ["Auth"], "operationId": "updateProfile", "summary": "Изменить профиль", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" } } } },
        "responses": { "200": { "description": "Обновлённый профиль", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/auth/profile/password": {
      "put": {
        "tags": ["Auth"], "operationId": "changePassword", "summary": "Сменить пароль", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePasswordRequest" } } } },
        "responses": { "200": { "description": "Пароль изменён", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Message" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/products/all": {
      "get": {
        "tags": ["Products"], "operationId": "listProducts", "summary": "Каталог",
        "responses": { "200": { "description": "Список товаров", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } } } } } }
      }
    },
    "/products/by-uuid": {
      "post": {
        "tags": ["Products"], "operationId": "getProductByUuid", "summary": "Карточка товара по UUID",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductUuidRequest" } } } },
        "responses": {
          "200": { "description": "Товар", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/products/categories/tree": {
      "get": {
        "tags": ["Products"], "operationId": "getCategoryTree", "summary": "Дерево категорий",
        "responses": { "200": { "description": "Дерево категорий", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/CategoryNode" } } } } } }
      }
    },
    "/products/reviews/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
      "get": {
        "tags": ["Reviews"], "operationId": "listProductReviews", "summary": "Отзывы о товаре",
        "responses": { "200": { "description": "Отзывы", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ProductReview" } } } } } }
      }
    },
    "/products/review/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
      "post": {
        "tags": ["Reviews"], "operationId": "saveProductReview", "summary": "Создать или обновить свой отзыв", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SaveReviewRequest" } } } },
        "responses": { "200": { "description": "Сохранённый отзыв", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductReview" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/order": {
      "post": {
        "tags": ["Orders"], "operationId": "createOrder", "summary": "Оформить заказ", "security": [{ "bearerAuth": [] }],
        "description": "Повтор с тем же непустым idempotencyKey для клиента возвращает прежний заказ. Цена и остаток проверяются сервером.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrderRequest" } } } },
        "responses": {
          "201": { "description": "Заказ создан", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/order/my": {
      "get": {
        "tags": ["Orders"], "operationId": "listMyOrders", "summary": "Мои заказы", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Заказы клиента", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/order/my/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/OrderId" }],
      "get": {
        "tags": ["Orders"], "operationId": "getMyOrder", "summary": "Подробности заказа", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Заказ, состав, получение, оплата и события", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderDetail" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "put": {
        "tags": ["Orders"], "operationId": "updatePendingOrder", "summary": "Изменить получателя или получение до подтверждения", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdatePendingOrderRequest" } } } },
        "responses": { "200": { "description": "Обновлённый заказ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderDetail" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/order/my/{id}/cancel": {
      "parameters": [{ "$ref": "#/components/parameters/OrderId" }],
      "post": {
        "tags": ["Orders"], "operationId": "cancelMyOrder", "summary": "Отменить заказ", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Отменённый заказ; повторная отмена безопасна", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderDetail" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/order/promotions": {
      "get": {
        "tags": ["Promotions"], "operationId": "listPromotions", "summary": "Активные акции",
        "responses": { "200": { "description": "Акции", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Promotion" } } } } } }
      }
    },
    "/order/promo/validate": {
      "post": {
        "tags": ["Promotions"], "operationId": "validatePromo", "summary": "Проверить промокод", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidatePromoRequest" } } } },
        "responses": { "200": { "description": "Данные применимого промокода", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/order/loyalty": {
      "get": {
        "tags": ["Orders"], "operationId": "getLoyaltyAccount", "summary": "Баланс и история бонусов", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Программа лояльности клиента", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoyaltyAccount" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/order/delivery/quote": {
      "post": {
        "tags": ["Orders"], "operationId": "quoteDelivery", "summary": "Рассчитать получение", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeliveryQuoteRequest" } } } },
        "responses": { "200": { "description": "Стоимость и срок; сейчас используется заглушка доставки", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeliveryQuote" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/order/stores": {
      "get": {
        "tags": ["Orders"], "operationId": "listPickupStores", "summary": "Доступные магазины для самовывоза", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Активные магазины", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/PickupStore" } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/notifications": {
      "get": {
        "tags": ["Notifications"], "operationId": "listNotifications", "summary": "Уведомления клиента", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 } }],
        "responses": { "200": { "description": "Последние уведомления", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Notification" } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/notifications/unread-count": {
      "get": {
        "tags": ["Notifications"], "operationId": "countUnreadNotifications", "summary": "Число непрочитанных уведомлений", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Число непрочитанных", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UnreadNotificationCount" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/notifications/{id}/read": {
      "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
      "patch": {
        "tags": ["Notifications"], "operationId": "markNotificationRead", "summary": "Пометить своё уведомление прочитанным", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Уведомление прочитано", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MarkNotificationReadResult" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/subscriptions": {
      "post": {
        "tags": ["Subscriptions"], "operationId": "subscribeNewsletter", "summary": "Подписаться на новости; вход необязателен",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubscribeRequest" } } } },
        "responses": { "200": { "description": "Подписка активна", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubscriptionStatus" } } } }, "400": { "$ref": "#/components/responses/BadRequest" } }
      },
      "delete": {
        "tags": ["Subscriptions"], "operationId": "unsubscribeNewsletter", "summary": "Отписаться от новостей", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Подписка отключена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubscriptionStatus" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/subscriptions/status": {
      "get": {
        "tags": ["Subscriptions"], "operationId": "getSubscriptionStatus", "summary": "Статус подписки клиента", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Текущий статус", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubscriptionStatus" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "parameters": {
      "OrderId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "ResourceId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "responses": {
      "Unauthorized": {
        "description": "Нет токена, JWT неверен или указаны неверные учётные данные",
        "headers": { "X-Request-Id": { "description": "Доверенный ID запроса", "schema": { "type": "string", "format": "uuid" } } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "BadRequest": { "description": "Некорректный запрос", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
      "NotFound": { "description": "Ресурс не найден", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
    },
    "schemas": {
      "Message": { "type": "object", "properties": { "message": { "type": "string" } } },
      "ApiError": {
        "type": "object", "required": ["code", "message", "fieldErrors", "requestId", "timestamp"],
        "properties": {
          "code": { "type": "string", "description": "Стабильный машинный код, например BAD_REQUEST, NOT_FOUND или INVALID_TOKEN" },
          "message": { "type": "string" }, "fieldErrors": { "type": "object", "additionalProperties": true },
          "requestId": { "type": "string", "format": "uuid" }, "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "RegisterRequest": {
        "type": "object", "required": ["email", "password", "firstName", "lastName"],
        "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password" }, "firstName": { "type": "string" }, "lastName": { "type": "string" } }
      },
      "LoginRequest": {
        "type": "object", "required": ["email", "password"],
        "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password" } }
      },
      "AuthResponse": {
        "type": "object", "required": ["uuid", "email", "role", "token"],
        "properties": {
          "uuid": { "type": "string", "format": "uuid" }, "email": { "type": "string", "format": "email" },
          "firstName": { "type": "string" }, "lastName": { "type": "string" }, "phone": { "type": "string", "nullable": true },
          "role": { "type": "string" }, "token": { "type": "string", "nullable": true, "description": "JWT после входа; null при регистрации" }
        }
      },
      "UserProfile": {
        "type": "object", "required": ["id", "email", "role"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }, "email": { "type": "string", "format": "email" },
          "firstName": { "type": "string" }, "lastName": { "type": "string" }, "phone": { "type": "string", "nullable": true },
          "birthday": { "type": "string", "format": "date", "nullable": true }, "avatar": { "type": "string", "nullable": true }, "role": { "type": "string" }
        }
      },
      "UpdateProfileRequest": {
        "type": "object", "required": ["email", "firstName", "lastName"], "properties": {
          "email": { "type": "string", "format": "email" }, "firstName": { "type": "string" }, "lastName": { "type": "string" },
          "phone": { "type": "string" }, "birthday": { "type": "string", "format": "date" }, "avatar": { "type": "string" }
        }
      },
      "ChangePasswordRequest": {
        "type": "object", "required": ["currentPassword", "newPassword"],
        "properties": { "currentPassword": { "type": "string", "format": "password" }, "newPassword": { "type": "string", "format": "password" } }
      },
      "ProductUuidRequest": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "format": "uuid" } } },
      "Product": {
        "type": "object", "required": ["id", "name", "price"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "description": { "type": "string", "nullable": true },
          "price": { "type": "number" }, "gender": { "type": "string", "nullable": true }, "imageUrl": { "type": "string", "nullable": true },
          "rating": { "type": "number" }, "reviewCount": { "type": "integer" },
          "categories": { "type": "array", "items": { "type": "string" } },
          "colors": { "type": "array", "items": { "$ref": "#/components/schemas/ProductColor" } },
          "stock": { "type": "array", "items": { "$ref": "#/components/schemas/ProductStock" } }
        }
      },
      "ProductColor": { "type": "object", "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "hexCode": { "type": "string" } } },
      "ProductStock": {
        "type": "object", "properties": {
          "sizeId": { "type": "string", "format": "uuid" }, "sizeName": { "type": "string" }, "sizeType": { "type": "string" },
          "sizeGender": { "type": "string" }, "sizeDescription": { "type": "string" },
          "colorId": { "type": "string", "format": "uuid" }, "colorName": { "type": "string" }, "quantity": { "type": "integer" }
        }
      },
      "OrderItemRequest": {
        "type": "object", "required": ["productId", "colorId", "sizeId", "quantity"],
        "properties": {
          "productId": { "type": "string", "format": "uuid" }, "colorId": { "type": "string", "format": "uuid" },
          "sizeId": { "type": "string", "format": "uuid" }, "quantity": { "type": "integer", "minimum": 1, "maximum": 20 }
        }
      },
      "CreateOrderRequest": {
        "type": "object", "required": ["address", "items"],
        "properties": {
          "customerName": { "type": "string" }, "customerEmail": { "type": "string", "format": "email" }, "customerPhone": { "type": "string", "description": "Если не передан, сервер берёт телефон из профиля; в итоге телефон обязателен" },
          "address": { "type": "string", "description": "Адрес доставки или название/адрес магазина самовывоза" },
          "deliveryMethod": { "type": "string", "enum": ["courier", "pickup"] },
          "paymentMethod": { "type": "string", "enum": ["CARD", "SBP", "ON_RECEIPT"] },
          "idempotencyKey": { "type": "string", "description": "Ключ идемпотентности передаётся в JSON-теле, не в HTTP-заголовке" },
          "promoCode": { "type": "string" }, "bonusesToUse": { "type": "integer", "minimum": 0 },
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/OrderItemRequest" } }
        }
      },
      "Order": {
        "type": "object", "required": ["id", "orderNumber", "status", "totalAmount"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }, "orderNumber": { "type": "string" }, "userId": { "type": "string", "format": "uuid" },
          "customerName": { "type": "string" }, "customerEmail": { "type": "string" }, "customerPhone": { "type": "string" },
          "status": { "type": "string", "enum": ["PENDING", "CONFIRMED", "ASSEMBLING", "SHIPPED", "DELIVERED", "CANCELLED"] },
          "subtotal": { "type": "number" }, "discountAmount": { "type": "number" },
          "bonusesUsed": { "type": "integer" }, "bonusesEarned": { "type": "integer" }, "promoCode": { "type": "string", "nullable": true },
          "totalAmount": { "type": "number" }, "createdAt": { "type": "string", "format": "date-time" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/OrderItem" } }
        }
      },
      "OrderDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/Order" },
          { "type": "object", "properties": {
            "delivery": { "type": "object", "nullable": true, "additionalProperties": true },
            "payment": { "type": "object", "nullable": true, "additionalProperties": true },
            "returns": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
            "events": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
          } }
        ]
      },
      "OrderItem": {
        "type": "object", "properties": {
          "productId": { "type": "string", "format": "uuid" }, "colorId": { "type": "string", "format": "uuid" },
          "colorName": { "type": "string", "nullable": true }, "sizeId": { "type": "string", "format": "uuid" },
          "sizeName": { "type": "string", "nullable": true }, "name": { "type": "string" },
          "imageUrl": { "type": "string" }, "quantity": { "type": "integer" }, "price": { "type": "number" }
        }
      },
      "UpdatePendingOrderRequest": {
        "type": "object", "required": ["address"], "properties": {
          "customerName": { "type": "string" }, "customerEmail": { "type": "string", "format": "email" },
          "customerPhone": { "type": "string" }, "address": { "type": "string" },
          "deliveryMethod": { "type": "string", "enum": ["courier", "pickup"] }
        }
      },
      "CategoryNode": { "type": "object", "required": ["id", "name", "children"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "parentId": { "type": "string", "format": "uuid", "nullable": true }, "children": { "type": "array", "items": { "$ref": "#/components/schemas/CategoryNode" } } } },
      "Promotion": {
        "type": "object", "properties": {
          "id": { "type": "string", "format": "uuid" }, "code": { "type": "string" }, "title": { "type": "string" },
          "description": { "type": "string" }, "discountPercent": { "type": "integer" }, "bonusMultiplier": { "type": "number" },
          "minOrder": { "type": "number" }, "birthdayOnly": { "type": "boolean" }, "validUntil": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "ValidatePromoRequest": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string" }, "subtotal": { "type": "number" } } },
      "SaveReviewRequest": { "type": "object", "required": ["rating", "body"], "properties": { "rating": { "type": "integer", "minimum": 1, "maximum": 5 }, "qualityRating": { "type": "integer", "minimum": 1, "maximum": 5 }, "fit": { "type": "string", "enum": ["SMALL", "AS_EXPECTED", "LARGE"] }, "photoUrl": { "type": "string", "maxLength": 1000 }, "body": { "type": "string", "minLength": 3, "maxLength": 1500 } } },
      "ProductReview": { "type": "object", "properties": { "id": { "type": "string", "format": "uuid" }, "userId": { "type": "string", "format": "uuid" }, "authorName": { "type": "string" }, "rating": { "type": "integer" }, "qualityRating": { "type": "integer" }, "fit": { "type": "string" }, "photoUrl": { "type": "string", "nullable": true }, "verifiedPurchase": { "type": "boolean" }, "body": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" } } },
      "LoyaltyAccount": { "type": "object", "properties": { "balance": { "type": "integer" }, "lifetimeEarned": { "type": "integer" }, "tier": { "type": "string" }, "updatedAt": { "type": "string", "format": "date-time" }, "birthdayToday": { "type": "boolean" }, "birthdayBenefit": { "type": "string" }, "transactions": { "type": "array", "items": { "$ref": "#/components/schemas/LoyaltyTransaction" } } } },
      "LoyaltyTransaction": { "type": "object", "properties": { "amount": { "type": "integer" }, "type": { "type": "string" }, "description": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" } } },
      "DeliveryQuoteRequest": { "type": "object", "properties": { "method": { "type": "string", "enum": ["courier", "pickup"] }, "subtotal": { "type": "number" } } },
      "DeliveryQuote": { "type": "object", "properties": { "method": { "type": "string", "enum": ["courier", "pickup"] }, "cost": { "type": "number" }, "estimatedDays": { "type": "integer" }, "provider": { "type": "string" } } },
      "PickupStore": { "type": "object", "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "city": { "type": "string" }, "address": { "type": "string" }, "phone": { "type": "string", "nullable": true }, "hours": { "type": "string", "nullable": true }, "latitude": { "type": "number", "nullable": true }, "longitude": { "type": "number", "nullable": true }, "active": { "type": "boolean" } } },
      "Notification": { "type": "object", "required": ["id", "type", "title", "message", "read", "createdAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "recipientUuid": { "type": "string" }, "type": { "type": "string" }, "title": { "type": "string" }, "message": { "type": "string" }, "read": { "type": "boolean" }, "createdAt": { "type": "string", "format": "date-time" } } },
      "UnreadNotificationCount": { "type": "object", "required": ["count"], "properties": { "count": { "type": "integer" } } },
      "MarkNotificationReadResult": { "type": "object", "required": ["read"], "properties": { "read": { "type": "boolean" } } },
      "SubscribeRequest": { "type": "object", "required": ["email"], "properties": { "email": { "type": "string", "format": "email" } } },
      "SubscriptionStatus": { "type": "object", "required": ["active"], "properties": { "active": { "type": "boolean" }, "email": { "type": "string", "format": "email" } } }
    }
  }
