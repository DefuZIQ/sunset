{
  "uid": "sunset-overview",
  "title": "SUNSET — сервисы",
  "tags": ["sunset", "operations"],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [{
      "name": "instance",
      "label": "Сервис",
      "type": "query",
      "datasource": "SUNSET Prometheus",
      "query": "label_values(up{job=\"sunset-services\"}, instance)",
      "refresh": 1,
      "includeAll": true,
      "allValue": ".*",
      "multi": true,
      "current": { "text": "All", "value": "$__all" }
    }]
  },
  "panels": [
    {
      "id": 1,
      "title": "Доступность сервисов, %",
      "type": "stat",
      "datasource": "SUNSET Prometheus",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "100 * sum(up{job=\"sunset-services\",instance=~\"$instance\"}) / count(up{job=\"sunset-services\",instance=~\"$instance\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 100 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area", "justifyMode": "center" }
    },
    {
      "id": 2,
      "title": "Доступность по сервисам",
      "type": "timeseries",
      "datasource": "SUNSET Prometheus",
      "gridPos": { "h": 7, "w": 18, "x": 6, "y": 0 },
      "targets": [{ "expr": "up{job=\"sunset-services\",instance=~\"$instance\"}", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "HTTP запросы / сек",
      "type": "timeseries",
      "datasource": "SUNSET Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [{ "expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"sunset-services\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Ошибки HTTP 5xx, %",
      "type": "timeseries",
      "datasource": "SUNSET Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [{ "expr": "100 * (sum by (instance) (rate(http_server_requests_seconds_count{job=\"sunset-services\",instance=~\"$instance\",status=~\"5..\"}[5m])) or on(instance) 0 * sum by (instance) (rate(http_server_requests_seconds_count{job=\"sunset-services\",instance=~\"$instance\"}[5m]))) / clamp_min(sum by (instance) (rate(http_server_requests_seconds_count{job=\"sunset-services\",instance=~\"$instance\"}[5m])), 0.001)", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Средняя задержка HTTP, мс",
      "type": "timeseries",
      "datasource": "SUNSET Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [{ "expr": "1000 * sum by (instance) (rate(http_server_requests_seconds_sum{job=\"sunset-services\",instance=~\"$instance\"}[5m])) / clamp_min(sum by (instance) (rate(http_server_requests_seconds_count{job=\"sunset-services\",instance=~\"$instance\"}[5m])), 0.001)", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Использование Java heap, %",
      "type": "timeseries",
      "datasource": "SUNSET Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [{ "expr": "100 * sum by (instance) (jvm_memory_used_bytes{job=\"sunset-services\",instance=~\"$instance\",area=\"heap\"}) / clamp_min(sum by (instance) (jvm_memory_max_bytes{job=\"sunset-services\",instance=~\"$instance\",area=\"heap\"}), 1)", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Свободно на системном диске",
      "type": "stat",
      "datasource": "SUNSET Prometheus",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 23 },
      "targets": [{ "expr": "node_filesystem_avail_bytes{job=\"sunset-host\",mountpoint=\"/\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 2147483648 }, { "color": "green", "value": 6442450944 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 8,
      "title": "Свободное место, %",
      "type": "timeseries",
      "datasource": "SUNSET Prometheus",
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 23 },
      "targets": [{ "expr": "100 * node_filesystem_avail_bytes{job=\"sunset-host\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"sunset-host\",mountpoint=\"/\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 5 }, { "color": "green", "value": 15 }] } }, "overrides": [] }
    }
  ]
}
