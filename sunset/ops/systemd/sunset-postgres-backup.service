[Unit]
Description=SUNSET PostgreSQL logical backup and integrity check
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/defuziq/sunset
ExecStart=/bin/sh /home/defuziq/sunset/scripts/backup-postgres.sh /home/defuziq/sunset /home/defuziq/backups
UMask=0077
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
