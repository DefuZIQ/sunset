FROM maven:3.9.9-eclipse-temurin-17 AS build

ARG MODULE
ARG JAR_NAME

WORKDIR /build
COPY pom.xml ./
COPY backend ./backend
RUN mvn -pl "backend/${MODULE}" -am package -DskipTests

FROM eclipse-temurin:17-jre-alpine

ARG MODULE
ARG JAR_NAME

WORKDIR /app
COPY --from=build "/build/backend/${MODULE}/target/${JAR_NAME}.jar" app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
